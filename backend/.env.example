# ---------------------------------------------------------------------------------
# Multimodal Construction Intelligence Platform — backend configuration
# Copy to `.env` and fill in what you need. EVERY setting has a safe default, so the
# app runs with no .env at all (in deterministic heuristic mode).
# ---------------------------------------------------------------------------------

# -- App ---------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false

# -- CORS --------------------------------------------------------------------------
# Comma-separated. Add your deployed frontend origin here in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# -- AI provider -------------------------------------------------------------------
# auto  = pick the first configured provider, else fall back to heuristics
# openai | anthropic | gemini | heuristic
AI_PROVIDER=auto

# Option A — OpenAI (vision + text)
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1   # override for Azure/proxy endpoints

# Option B — Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-7-sonnet-latest

# Option C — Google Gemini
# GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.0-flash

LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=2000

# -- Uploads -----------------------------------------------------------------------
MAX_UPLOAD_MB=12
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# -- Weather -----------------------------------------------------------------------
# open-meteo requires no key; the service falls back to a simulator if it is unreachable.
WEATHER_PROVIDER=open-meteo
DEFAULT_CITY=Indore
DEFAULT_LATITUDE=22.7196
DEFAULT_LONGITUDE=75.8577

# -- Static / SPA ------------------------------------------------------------------
SERVE_FRONTEND=true
STATIC_DIR=static
